[Unit]
Description=Credere demo web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/credere/credere/backend
Environment=CREDERE_HOME=/opt/credere/.credere
Environment=CREDERE_DATA=/opt/credere/credere-data
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/credere/venv/bin/python -m app.web --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/credere/.credere

[Install]
WantedBy=multi-user.target
